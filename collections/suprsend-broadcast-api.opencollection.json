{
  "opencollection": "1.0.0",
  "info": {
    "name": "SuprSend Broadcast API",
    "version": "1.2.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Broadcast",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Trigger Broadcast",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://hub.suprsend.com/:workspace_key/broadcast/",
            "params": [
              {
                "name": "workspace_key",
                "value": "",
                "type": "path",
                "description": "unique identifier of your workspace"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "API to trigger broadcast notification to list users."
        }
      ]
    }
  ],
  "bundled": true
}