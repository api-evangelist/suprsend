{
  "opencollection": "1.0.0",
  "info": {
    "name": "SuprSend Broadcast Ws Api Key API",
    "version": "1.2.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Ws Api Key",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Workspace API Keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://hub.suprsend.com/v1/:workspace/ws_api_key/",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path",
                "description": "Workspace slug (e.g. `staging`, `production`)."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "ServiceToken <token>",
              "value": "{{ServiceToken <token>}}",
              "placement": "header"
            }
          },
          "docs": "List API keys scoped to a workspace. Secret values are never returned on list; only a masked preview is shown."
        },
        {
          "info": {
            "name": "Create Workspace API Key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://hub.suprsend.com/v1/:workspace/ws_api_key/",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path",
                "description": "Workspace slug (e.g. `staging`, `production`)."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "ServiceToken <token>",
              "value": "{{ServiceToken <token>}}",
              "placement": "header"
            }
          },
          "docs": "Create a new API key scoped to this workspace.\n\nThe full `api_key` secret is returned **only once** in the create response. Store it securely - it cannot be retrieved later.\n"
        },
        {
          "info": {
            "name": "Delete API Key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://hub.suprsend.com/v1/:workspace/ws_api_key/:api_key_id/",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path",
                "description": "Workspace slug (e.g. `staging`, `production`)."
              },
              {
                "name": "api_key_id",
                "value": "",
                "type": "path",
                "description": "API key identifier (e.g. `ws_apik_...`)."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "ServiceToken <token>",
              "value": "{{ServiceToken <token>}}",
              "placement": "header"
            }
          },
          "docs": "Delete an API key by its `id` (e.g. `ws_apik_...`). Once disabled, the key can no longer authenticate requests."
        }
      ]
    }
  ],
  "bundled": true
}