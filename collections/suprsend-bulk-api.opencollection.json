{
  "opencollection": "1.0.0",
  "info": {
    "name": "SuprSend Broadcast Bulk API",
    "version": "1.2.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Bulk",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Bulk Update",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://hub.suprsend.com/v1/bulk/user/preference/",
            "params": [
              {
                "name": "tenant_id",
                "value": "",
                "type": "query",
                "description": "to fetch user preferences for a particular tenant"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Bulk API to update channel and category-level notification preferences for multiple users in one request."
        },
        {
          "info": {
            "name": "Reset",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://hub.suprsend.com/v1/bulk/user/preference/reset/",
            "params": [
              {
                "name": "tenant_id",
                "value": "",
                "type": "query",
                "description": "to fetch user preferences for a particular tenant"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "API to reset user preference settings to default preference."
        },
        {
          "info": {
            "name": "Bulk Update Message Status",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://hub.suprsend.com/v1/bulk/message/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Change the status of messages by passing their id and notification action."
        }
      ]
    }
  ],
  "bundled": true
}