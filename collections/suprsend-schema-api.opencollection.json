{
  "opencollection": "1.0.0",
  "info": {
    "name": "SuprSend Broadcast Schema API",
    "version": "1.2.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Schema",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Schemas",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://hub.suprsend.com/v1/:workspace/schema/",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path",
                "description": "Workspace slug (staging, production, etc.)"
              },
              {
                "name": "mode",
                "value": "",
                "type": "query",
                "description": "Specify if you want to fetch draft or live schema."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "ServiceToken <token>",
              "value": "{{ServiceToken <token>}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve a list of schemas in a workspace."
        },
        {
          "info": {
            "name": "Get Schema",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://hub.suprsend.com/v1/:workspace/schema/:schema_slug/",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path",
                "description": "Workspace slug (staging, production, etc.)"
              },
              {
                "name": "schema_slug",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the schema"
              },
              {
                "name": "mode",
                "value": "",
                "type": "query",
                "description": "Mode to fetch schema (draft or live). By default, draft schema is returned."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "ServiceToken <token>",
              "value": "{{ServiceToken <token>}}",
              "placement": "header"
            }
          },
          "docs": "Fetch the JSON schema corresponding to a slug."
        },
        {
          "info": {
            "name": "Create/Update Schema",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://hub.suprsend.com/v1/:workspace/schema/:schema_slug/",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path",
                "description": "Workspace slug (staging, production, etc.)"
              },
              {
                "name": "schema_slug",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the schema"
              },
              {
                "name": "commit",
                "value": "",
                "type": "query",
                "description": "Set to true to commit the schema immediately after creation/update"
              },
              {
                "name": "commit_message",
                "value": "",
                "type": "query",
                "description": "Commit message describing the changes (required when commit=true)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "ServiceToken <token>",
              "value": "{{ServiceToken <token>}}",
              "placement": "header"
            }
          },
          "docs": "Upset draft version of a JSON schema. Creates a new schema if it doesn't exist."
        },
        {
          "info": {
            "name": "Commit Schema",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://hub.suprsend.com/v1/:workspace/schema/:schema_slug/commit/",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path",
                "description": "Workspace slug (staging, production, etc.)"
              },
              {
                "name": "schema_slug",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the schema"
              },
              {
                "name": "commit_message",
                "value": "",
                "type": "query",
                "description": "Commit message describing the changes"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "ServiceToken <token>",
              "value": "{{ServiceToken <token>}}",
              "placement": "header"
            }
          },
          "docs": "Commit a draft schema to make it live. Changes will start to take effect as soon as it's live."
        }
      ]
    }
  ],
  "bundled": true
}