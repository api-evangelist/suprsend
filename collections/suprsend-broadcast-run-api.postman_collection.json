          "name": "Cancel Broadcast",
          "request": {
            "name": "Cancel Broadcast",
            "description": {
              "content": "API to cancel a running broadcast execution. You can cancel a broadcast by passing any combination of filters in the request body. When multiple parameters are provided, they are **ANDed** together to narrow down the matching broadcast runs.\n\nFor example, passing both `list_id` and `idempotency_key` will cancel only the broadcast runs that match both the given list and idempotency key.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "broadcast_run",
                "cancel",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"execution_id\": \"<string>\",\n  \"list_id\": \"<string>\",\n  \"idempotency_key\": \"<string>\"\n}",
